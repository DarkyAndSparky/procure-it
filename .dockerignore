# Dependencies — reinstalled inside image via npm ci
node_modules/

# Runtime data — mounted as volumes, must not bake into image
data/
logs/

# Dev / repo files
.git/
.github/
docs/
*.md
.env
.env.*
!.env.example

# Start / install / test scripts — dev-инструменты, не нужны внутри
# контейнера (Dockerfile сам делает npm ci --omit=dev + явный COPY нужных
# директорий; test/ и так не копируется, но явное правило — для ясности и
# на случай, если COPY когда-нибудь заменят на `COPY . .`)
start.bat
start.sh
install.bat
install.sh
test.bat
test.sh
test/

# OS noise
.DS_Store
Thumbs.db
*.swp
*.swo

# entrypoint is explicitly needed — do NOT ignore it
# docker-entrypoint.sh is included via COPY in Dockerfile
