# IT Assets — переменные окружения
#
# Все опциональны — сервер стартует и без .env, со значениями по умолчанию,
# указанными ниже в комментариях. Скопируйте в .env и раскомментируйте то,
# что хотите изменить (сам .env в .gitignore, не коммитится).

# Порты (по умолчанию 3000/3443)
# PORT=3000
# HTTPS_PORT=3443

# Куда класть db.json/config.json/it-assets.sqlite/backups/cert.pem
# (по умолчанию — ./data рядом с server/)
# IT_ASSETS_DATA_DIR=./data

# Разрешённые CORS-origin'ы через запятую (по умолчанию — не ограничено)
# CORS_ORIGINS=https://it-assets.example.com

# За обратным прокси (nginx/traefik) — доверять X-Forwarded-* заголовкам
# TRUST_PROXY=1

# Автобэкап (см. CHANGELOG.md — настраиваемость подсмотрена в atlas-server,
# сама система бэкапов — наша, ZIP с БД+конфигом). По умолчанию включён,
# раз в час — эти значения ничего не меняют, если оставить закомментированными.
# IT_ASSETS_AUTO_BACKUP_ENABLED=1
# IT_ASSETS_AUTO_BACKUP_INTERVAL_MIN=60

# Максимальный суммарный размер папки data/backups/ в мегабайтах
# (по умолчанию 2048 = 2GB)
# IT_ASSETS_BACKUP_MAX_MB=2048

# Сколько дней хранить файлы логов (по умолчанию 14, см. server/logger.js)
# IT_ASSETS_LOG_RETENTION_DAYS=14

# production/test/development — влияет на фоновые таймеры (бэкапы,
# rate-limit cleanup отключены в test) и вывод стектрейсов в ошибках
# NODE_ENV=production
