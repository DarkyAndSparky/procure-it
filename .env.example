# Server port (default: 9111)
PORT=9111

# Legacy single-password auth (only used as a fallback if no users exist yet
# in the database). The app now has a built-in multi-user system with roles
# (viewer / operator / admin) — the default admin account (login "admin",
# random one-time password printed once to the console on first start,
# forced password change on first login) is created automatically on first
# run. Leave this empty unless you specifically need the old single-password
# mode for a fresh install with no UI access yet.
# PROCURE_PASSWORD=your_secret_password

# Set a fixed password for the auto-created first admin account instead of
# a random one-time password. Mainly useful for scripted/CI setups where you
# need a known password ahead of time.
# PROCURE_INITIAL_ADMIN_PASSWORD=

# Trust X-Forwarded-Proto/X-Forwarded-Host headers from a reverse proxy
# (nginx, Caddy, Traefik). Off by default: without a trusted proxy in front,
# a client could forge these headers to get a password-reset link pointing
# at an attacker-controlled host. Only enable if procure-it actually runs
# behind such a proxy that overwrites these headers.
# PROCURE_TRUST_PROXY=true

# Auto-backup interval in milliseconds (default: 6 hours)
BACKUP_INTERVAL_MS=21600000
