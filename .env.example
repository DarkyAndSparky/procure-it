# Server port (default: 9111)
PORT=9111

# Legacy single-password auth (only used as a fallback if no users exist yet
# in the database). The app now has a built-in multi-user system with roles
# (viewer / operator / admin) — the default admin account (admin / admin0000,
# forced password change on first login) is created automatically on first
# run. Leave this empty unless you specifically need the old single-password
# mode for a fresh install with no UI access yet.
# PROCURE_PASSWORD=your_secret_password

# Auto-backup interval in milliseconds (default: 6 hours)
BACKUP_INTERVAL_MS=21600000
