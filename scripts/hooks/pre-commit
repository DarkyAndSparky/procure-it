#!/usr/bin/env bash
# Pre-commit хук procure-it.
# Ставится автоматически при `npm install` (см. package.json -> "prepare"
# -> scripts/install-hooks.js). Не блокирует коммит намертво - только
# напоминает и просит подтверждения.
#
# Логика: если в коммите меняются файлы в src/, public/js/ или
# public/*.html (то есть реальная функциональность), но CHANGELOG.md в этом
# же коммите не тронут - просим подтверждения. Отвечаешь "n" - коммит
# отменяется, идёшь дописывать запись в CHANGELOG.md. Отвечаешь "y" -
# коммит проходит как есть (например, чисто рефакторинг без видимого эффекта).

staged=$(git diff --cached --name-only)

touches_code=$(echo "$staged" | grep -E '^(src/|public/js/|public/.*\.html)' | grep -v -E '^(src/changelog\.js|test/)')
touches_changelog=$(echo "$staged" | grep -E '^CHANGELOG\.md$')

if [ -n "$touches_code" ] && [ -z "$touches_changelog" ]; then
  echo ""
  echo "WARNING: В коммите есть изменения в коде, но CHANGELOG.md не тронут:"
  echo "$touches_code" | sed 's/^/    /'
  echo ""
  if [ ! -t 1 ]; then
    echo "    (не интерактивный терминал - коммит пропущен без подтверждения)"
    exit 0
  fi
  read -p "Продолжить коммит без записи в CHANGELOG.md? [y/N] " answer < /dev/tty
  case "$answer" in
    [Yy]*) exit 0 ;;
    *) echo "Коммит отменён - допиши запись в CHANGELOG.md."; exit 1 ;;
  esac
fi

exit 0
